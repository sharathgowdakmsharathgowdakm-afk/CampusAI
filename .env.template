# Flask Configuration
SECRET_KEY=your_super_secret_key_here
FLASK_ENV=development
# Change FLASK_ENV to 'production' when deploying

# Database Configuration (MySQL recommended for production)
# Format: mysql://username:password@host:port/database_name
# Example for local MySQL:
# DATABASE_URL=mysql://root:password@localhost/attendance_db

# Or use PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost/attendance_db

# To use SQLite (default for development):
# DATABASE_URL=sqlite:///attendance.db

# ─── SMS NOTIFICATIONS (Absent Student Alerts) ─────────────────────
# Provider options: 'fast2sms' (India), 'twilio' (International), 'console' (dev/testing)
SMS_PROVIDER=fast2sms

# Fast2SMS (India) — Sign up free at https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio (International) — Sign up at https://www.twilio.com
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+1234567890
